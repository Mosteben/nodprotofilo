# -----------------------------------------------------------------------------
# Copy this file to `.env.local` for local development, and add the same
# variables in Vercel → Project → Settings → Environment Variables.
# Never commit real values.
# -----------------------------------------------------------------------------

# Supabase project URL.
# Supabase Dashboard → Project Settings → API → "Project URL"
# e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key. Safe for the browser — access is limited by Row Level Security.
# Supabase Dashboard → Project Settings → API → "Project API keys" → "anon public"
# (newer projects may label it "publishable key"; either works here).
# NEVER put the service_role / secret key in this project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the deployed site, without a trailing slash. Used for SEO metadata,
# the sitemap, RSS and Open Graph links. Optional in development.
# e.g. https://your-name.vercel.app
NEXT_PUBLIC_SITE_URL=
